# Copie para .env e preencha. NUNCA commite o .env (AGENTS.md §6).
# Os valores abaixo são falsos e servem só de modelo.

# --- Django ---
DJANGO_SECRET_KEY=troque-esta-chave-em-qualquer-ambiente-real
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

# Chave do código público da contraparte (AGENTS.md D59). Gere com:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
# ATENÇÃO: esta chave NUNCA rotaciona. Girá-la trocaria o código de todas as
# contrapartes. Ela entra no backup, e é a mesma em todos os ambientes que
# precisem gerar o mesmo código para o mesmo CPF/CNPJ.
HASH_KEY=troque-por-uma-chave-aleatoria-e-nunca-mais-mude

# --- Banco ---
# Local via Docker Compose:
DATABASE_URL=postgres://arena:arena@localhost:5432/arena
# Produção: apontar para o RDS. ATENÇÃO: o .env local NUNCA aponta para o RDS (AGENTS.md §6).

# --- Fila ---
REDIS_URL=redis://localhost:6379/0

# --- Armazenamento de documentos ---
# s3 | local
ARMAZENAMENTO=local
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_STORAGE_BUCKET_NAME=
AWS_S3_REGION_NAME=sa-east-1
# Preenchido apenas ao usar MinIO em desenvolvimento:
AWS_S3_ENDPOINT_URL=

# --- Provedor de IA documental (AGENTS.md §5.1) ---
# gemini | local | fake
PROVEDOR_IA=fake
GEMINI_API_KEY=
GEMINI_MODELO=gemini-2.5-flash-lite
# Endpoint do proxy de modelo local, quando PROVEDOR_IA=local (D16)
IA_LOCAL_URL=

# --- Provedor de compliance (AGENTS.md §5.2) ---
# fake | trillia
PROVEDOR_COMPLIANCE=fake
TRILLIA_API_TOKEN=
TRILLIA_BASE_URL=
